{
  "schemaVersion": 1,
  "id": "example.productivity",
  "name": "Productivity examples",
  "version": "1.0.0",
  "publisher": "Plana Desktop examples",
  "actions": [
    {
      "id": "example.open-website",
      "label": "Open example.com",
      "kind": "url.open",
      "parameters": { "url": "https://example.com" },
      "capabilities": ["url.open"]
    },
    {
      "id": "example.open-notepad",
      "label": "Open Notepad",
      "kind": "process.launch",
      "parameters": { "executable": "notepad.exe" },
      "capabilities": ["process.launch"]
    },
    {
      "id": "example.open-pack-folder",
      "label": "Open this pack folder",
      "kind": "folder.open",
      "parameters": { "path": "." },
      "capabilities": ["folder.open"]
    },
    {
      "id": "example.run-hello-script",
      "label": "Run the example script",
      "kind": "script.run",
      "parameters": {
        "interpreter": "powershell.exe",
        "script": "scripts/hello.ps1",
        "arg.0": "Plana"
      },
      "capabilities": ["script.run"],
      "requiresConfirmation": true
    }
  ]
}
