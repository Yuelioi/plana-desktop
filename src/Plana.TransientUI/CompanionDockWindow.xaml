<Window x:Class="Plana.TransientUI.CompanionDockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="340" Height="82" MinWidth="280" MinHeight="52"
        AllowsTransparency="True" Background="Transparent"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.88" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.72" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.48" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Margin="3" Padding="5" CornerRadius="14"
            Background="#F20C121F" BorderBrush="#485F9C" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.28" Color="#07101F" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ActionsRow" Height="26" />
                <RowDefinition x:Name="ActionsGap" Height="4" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>
            <UniformGrid x:Name="ActionPanel" Grid.Row="0" Rows="1" />
            <Border Grid.Row="2" CornerRadius="10" Background="#121B2E" BorderBrush="#2A3A5E" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputBox" Margin="11,0,4,0" BorderThickness="0" Background="Transparent"
                             Foreground="#F6F8FF" CaretBrush="#F6F8FF" VerticalContentAlignment="Center"
                             FontSize="14" KeyDown="InputBox_KeyDown" />
                    <TextBlock x:Name="InputPlaceholder" Margin="11,0,4,0" VerticalAlignment="Center"
                               Foreground="#97A2BE" IsHitTestVisible="False" Text="说些什么吧…" />
                    <Button x:Name="SendButton" Grid.Column="1" Width="30" Height="30" Margin="3"
                            BorderThickness="0" Background="#4E6FD8" Foreground="White"
                            FontFamily="Segoe UI Symbol" FontSize="14" Content="➤"
                            Click="SendButton_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
