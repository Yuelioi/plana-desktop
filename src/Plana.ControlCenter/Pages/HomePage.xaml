<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Plana_ControlCenter.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Plana_ControlCenter.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32,24,32,32" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="PageTitle" Style="{StaticResource PageTitleStyle}" Text="Actions" />

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" QueryIcon="Find" PlaceholderText="Search actions" TextChanged="SearchBox_TextChanged" QuerySubmitted="SearchBox_QuerySubmitted" />
            <Button x:Name="AddActionButton" Grid.Column="1" MinWidth="132" Style="{StaticResource CommandButtonStyle}" Click="AddActionButton_Click">
                <StackPanel Style="{StaticResource CommandButtonContentStyle}">
                    <SymbolIcon Style="{StaticResource CommandIconStyle}" Symbol="Add" />
                    <TextBlock x:Name="AddActionLabel" Style="{StaticResource CommandLabelStyle}" Text="New action" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="2" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <InfoBar x:Name="ActionStatus" IsOpen="False" IsClosable="True" />
            <Grid Grid.Row="1" Padding="16,8" ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="140" /><ColumnDefinition Width="40" /><ColumnDefinition Width="40" /><ColumnDefinition Width="40" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="NameColumnHeader" FontWeight="SemiBold" Text="Name" />
                <TextBlock x:Name="DescriptionColumnHeader" Grid.Column="1" FontWeight="SemiBold" Text="Description" />
                <TextBlock x:Name="TypeColumnHeader" Grid.Column="2" FontWeight="SemiBold" Text="Type" />
            </Grid>
            <ListView x:Name="ActionList" Grid.Row="2" ItemsSource="{x:Bind VisibleActions}" IsItemClickEnabled="True" ItemClick="ActionList_ItemClick" SelectionMode="None">
                <ListView.Resources>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="60" />
                    </Style>
                </ListView.Resources>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ActionListItem">
                        <Grid Padding="8,10" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource PlanaSubtleBrush}" Text="{x:Bind Description}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind TypeLabel}" />
                            <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Tag="{x:Bind}" Click="PinActionButton_Click" AutomationProperties.Name="Pin to Companion" ToolTipService.ToolTip="{x:Bind PinLabel}"><SymbolIcon Symbol="{x:Bind PinSymbol}" /></Button>
                            <Button Grid.Column="4" Style="{StaticResource IconButtonStyle}" IsEnabled="{x:Bind CanManage}" Tag="{x:Bind}" Click="EditActionButton_Click" AutomationProperties.Name="Edit action"><SymbolIcon Symbol="Edit" /></Button>
                            <Button Grid.Column="5" Style="{StaticResource IconButtonStyle}" IsEnabled="{x:Bind CanManage}" Tag="{x:Bind}" Click="DeleteActionButton_Click" AutomationProperties.Name="Delete action"><SymbolIcon Symbol="Delete" /></Button>
                            <Button Grid.Column="6" Style="{StaticResource IconButtonStyle}" Tag="{x:Bind}" Click="RunActionButton_Click" AutomationProperties.Name="Run action">
                                <SymbolIcon Symbol="Play" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Footer>
                    <StackPanel x:Name="EmptyState" Margin="0,56,0,0" HorizontalAlignment="Center" Spacing="8" Visibility="Collapsed">
                        <SymbolIcon Symbol="Find" />
                        <TextBlock x:Name="EmptyTitle" HorizontalAlignment="Center" FontWeight="SemiBold" Text="No matching actions" />
                        <TextBlock x:Name="EmptyDescription" Foreground="{StaticResource PlanaSubtleBrush}" Text="Try another search or create an action." />
                    </StackPanel>
                </ListView.Footer>
            </ListView>
        </Grid>

        <ContentDialog x:Name="ActionEditorDialog" PrimaryButtonClick="ActionEditorDialog_PrimaryButtonClick">
            <ScrollViewer MaxHeight="520">
                <StackPanel Width="460" Spacing="16">
                    <TextBox x:Name="ActionNameInput" Header="Name" PlaceholderText="Open Codex project" />
                    <TextBox x:Name="ActionDescriptionInput" Header="Description" PlaceholderText="What this Action does" />
                    <ComboBox x:Name="ActionKindInput" Header="Type" HorizontalAlignment="Stretch" SelectionChanged="ActionKindInput_SelectionChanged">
                        <ComboBoxItem Tag="url.open" Content="Open website" />
                        <ComboBoxItem Tag="file.open" Content="Open file" />
                        <ComboBoxItem Tag="folder.open" Content="Open folder" />
                        <ComboBoxItem Tag="process.launch" Content="Launch application" />
                        <ComboBoxItem Tag="command.run" Content="Run command" />
                        <ComboBoxItem Tag="script.run" Content="Run script" />
                    </ComboBox>
                    <TextBox x:Name="ActionTargetInput" Header="Target" PlaceholderText="Path, URL, executable, or command" />
                    <TextBox x:Name="ActionScriptInput" Header="Script file" PlaceholderText="C:\projects\tool.ps1" Visibility="Collapsed" />
                    <TextBox x:Name="ActionArgumentsInput" Header="Arguments" PlaceholderText="One argument per line" AcceptsReturn="True" MinHeight="96" TextWrapping="Wrap" />
                    <TextBlock x:Name="ActionEditorError" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>

    </Grid>
</Page>
