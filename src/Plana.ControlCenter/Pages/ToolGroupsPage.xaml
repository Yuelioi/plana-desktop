<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Plana_ControlCenter.Pages.ToolGroupsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Plana_ControlCenter.Pages">
    <Grid Padding="32,24,32,32" RowSpacing="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Spacing="6">
            <TextBlock x:Name="PageTitle" Style="{StaticResource PageTitleStyle}" Text="Tool groups" />
            <TextBlock x:Name="PageDescription" Foreground="{StaticResource PlanaSubtleBrush}" Text="Organize optional shortcuts for the Companion toolbar." />
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" QueryIcon="Find" PlaceholderText="Search Tool Groups" TextChanged="SearchBox_TextChanged" />
            <Button Grid.Column="1" MinWidth="132" Click="NewGroupButton_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" /><TextBlock x:Name="NewGroupLabel" Text="New group" /></StackPanel></Button>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Padding="16,8" ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="40" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="NameHeader" FontWeight="SemiBold" Text="Name" />
                <TextBlock x:Name="ActionsHeader" Grid.Column="1" FontWeight="SemiBold" Text="Actions" />
            </Grid>
            <ListView Grid.Row="1" ItemsSource="{x:Bind VisibleGroups}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ToolGroupRow">
                        <Grid Padding="8,10" ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="40" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind Name}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource PlanaSubtleBrush}" Text="{x:Bind Summary}" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="2" Tag="{x:Bind}" Click="EditGroupButton_Click"><FontIcon Glyph="&#xE70F;" /></Button>
                            <Button Grid.Column="3" Tag="{x:Bind}" Click="DeleteGroupButton_Click"><FontIcon Glyph="&#xE74D;" /></Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <ContentDialog x:Name="GroupDialog" PrimaryButtonClick="GroupDialog_PrimaryButtonClick">
            <StackPanel Width="460" Spacing="14">
                <TextBox x:Name="GroupNameInput" Header="Name" PlaceholderText="Codex projects" />
                <TextBlock x:Name="OptionalActionsLabel" FontWeight="SemiBold" Text="Actions (optional)" />
                <TextBlock x:Name="OptionalActionsHelp" Foreground="{StaticResource PlanaSubtleBrush}" Text="An empty Tool Group is allowed. Add Actions now or edit it later." TextWrapping="Wrap" />
                <ListView x:Name="GroupActionsList" Height="280" SelectionMode="Multiple">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ToolGroupActionOption">
                            <StackPanel Padding="4,6"><TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" /><TextBlock FontSize="12" Foreground="{StaticResource PlanaSubtleBrush}" Text="{x:Bind Detail}" /></StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EditorError" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
