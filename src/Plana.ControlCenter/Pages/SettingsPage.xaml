<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Plana_ControlCenter.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Plana_ControlCenter.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
    <StackPanel Padding="32,24,32,40" Spacing="20" MaxWidth="660" HorizontalAlignment="Left">
        <TextBlock x:Name="PageTitle" Style="{StaticResource PageTitleStyle}" Text="Settings" />

        <StackPanel Spacing="8">
            <TextBlock x:Name="BehaviorHeading" Style="{StaticResource SectionTitleStyle}" Text="Companion" />
            <Grid Padding="4" ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="TopmostTitle" Style="{StaticResource SettingsRowTitleStyle}" Text="Keep above other windows" />
                <ToggleSwitch x:Name="TopmostToggle" Grid.Column="1" OnContent="" OffContent="" Toggled="TopmostToggle_Toggled" />
            </Grid>
            <Grid Padding="4" ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="StartupTitle" Style="{StaticResource SettingsRowTitleStyle}" Text="Start with Windows" />
                <ToggleSwitch x:Name="StartupToggle" Grid.Column="1" OnContent="" OffContent="" Toggled="StartupToggle_Toggled" />
            </Grid>
            <Grid Padding="4" ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="ScaleTitle" Style="{StaticResource SettingsRowTitleStyle}" Text="Companion scale" />
                <Slider x:Name="ScaleSlider" Grid.Column="1" Minimum="0.5" Maximum="2" StepFrequency="0.1" ValueChanged="ScaleSlider_ValueChanged" Header="100%" />
            </Grid>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock x:Name="CharacterHeading" Style="{StaticResource SectionTitleStyle}" Text="Character" />
            <Grid Padding="4" ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="CharacterTitle" Style="{StaticResource SettingsRowTitleStyle}" Text="Companion character" />
                <ComboBox x:Name="CharacterPicker" Grid.Column="1" HorizontalAlignment="Stretch" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="CharacterPicker_SelectionChanged" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,2,0,0">
                <Button x:Name="ImportCharacterButton" Click="ImportCharacterButton_Click" Style="{StaticResource AccentCommandButtonStyle}">
                    <StackPanel Style="{StaticResource CommandButtonContentStyle}"><Viewbox Style="{StaticResource CommandIconStyle}"><SymbolIcon Symbol="Download" /></Viewbox><TextBlock x:Name="ImportCharacterLabel" Style="{StaticResource CommandLabelStyle}" Text="Import Character Pack" /></StackPanel>
                </Button>
                <Button x:Name="ImportCharacterFolderButton" Click="ImportCharacterFolderButton_Click" Style="{StaticResource CommandButtonStyle}"><TextBlock x:Name="ImportCharacterFolderLabel" Style="{StaticResource CommandLabelStyle}" Text="Import folder" /></Button>
                <Button x:Name="OpenCharactersButton" Click="OpenCharactersButton_Click" Style="{StaticResource CommandButtonStyle}"><TextBlock x:Name="OpenCharactersLabel" Style="{StaticResource CommandLabelStyle}" Text="Open characters folder" /></Button>
                <Button x:Name="ReloadCharactersButton" Click="ReloadCharactersButton_Click" Style="{StaticResource CommandButtonStyle}"><Viewbox Style="{StaticResource CommandIconStyle}"><SymbolIcon Symbol="Refresh" /></Viewbox></Button>
            </StackPanel>
            <InfoBar x:Name="CharacterStatus" IsOpen="False" IsClosable="True" />
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock x:Name="LanguageHeading" Style="{StaticResource SectionTitleStyle}" Text="Language" />
            <Grid Padding="4" ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="LanguageTitle" Style="{StaticResource SettingsRowTitleStyle}" Text="Display language" />
                <ComboBox x:Name="LanguagePicker" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="LanguagePicker_SelectionChanged">
                    <ComboBoxItem Tag="en" Content="English" />
                    <ComboBoxItem Tag="zh-CN" Content="简体中文" />
                </ComboBox>
            </Grid>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock x:Name="InteractionsHeading" Style="{StaticResource SectionTitleStyle}" Text="Interactions" />
            <Grid Padding="4" ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="ClickTitle" Style="{StaticResource SettingsRowTitleStyle}" Text="Single click" />
                <ComboBox x:Name="ClickActionPicker" Grid.Column="1" HorizontalAlignment="Stretch" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="InteractionPicker_SelectionChanged" Tag="click" />
            </Grid>
            <Grid Padding="4" ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="DoubleClickTitle" Style="{StaticResource SettingsRowTitleStyle}" Text="Double click" />
                <ComboBox x:Name="DoubleClickActionPicker" Grid.Column="1" HorizontalAlignment="Stretch" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="InteractionPicker_SelectionChanged" Tag="doubleClick" />
            </Grid>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock x:Name="AiHeading" Style="{StaticResource SectionTitleStyle}" Text="AI conversation" />
            <Grid Padding="4" ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="AiProviderTitle" Style="{StaticResource SettingsRowTitleStyle}" Text="Provider" />
                <ComboBox x:Name="AiProviderPicker" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="AiProviderPicker_SelectionChanged">
                    <ComboBoxItem Tag="codex" Content="Codex CLI subscription" />
                    <ComboBoxItem Tag="api" Content="OpenAI-compatible API" />
                </ComboBox>
            </Grid>
            <TextBox x:Name="AiModelInput" Header="Model (optional for Codex)" PlaceholderText="gpt-5.6-luna (fast default)" />
            <StackPanel x:Name="AiApiPanel" Spacing="12" Visibility="Collapsed">
                <TextBox x:Name="AiApiBaseUrlInput" Header="API base URL" PlaceholderText="https://api.openai.com/v1" />
                <TextBox x:Name="AiApiKeyVariableInput" Header="API key environment variable" PlaceholderText="OPENAI_API_KEY" />
            </StackPanel>
            <TextBlock x:Name="AiHelpText" Foreground="{StaticResource PlanaSubtleBrush}" Text="Codex uses your existing local CLI login. API mode reads the key from the named environment variable." TextWrapping="Wrap" />
            <Button x:Name="SaveAiButton" HorizontalAlignment="Left" Style="{StaticResource AccentCommandButtonStyle}" Click="SaveAiButton_Click"><TextBlock x:Name="SaveAiLabel" Text="Save AI settings" /></Button>
        </StackPanel>

        <InfoBar x:Name="SaveStatus" IsOpen="False" IsClosable="True" Severity="Success" Title="Saved" Message="Changes are active." />
        <InfoBar x:Name="RestartNotice" IsOpen="False" IsClosable="True" Severity="Informational" Title="Language saved" Message="Reopen this window to apply the language everywhere." />
    </StackPanel>
    </ScrollViewer>
</Page>
