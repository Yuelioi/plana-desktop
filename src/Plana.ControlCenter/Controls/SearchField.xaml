<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Plana_ControlCenter.Controls.SearchField"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        x:Name="Frame"
        Height="40"
        Background="{ThemeResource TextControlBackground}"
        BorderBrush="{ThemeResource TextControlBorderBrush}"
        BorderThickness="1"
        CornerRadius="4">
        <Grid>
            <TextBox
                x:Name="Input"
                Height="24"
                Margin="12,0,40,0"
                Padding="0"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                PlaceholderText="{x:Bind PlaceholderText, Mode=OneWay}"
                Text="{x:Bind Text, Mode=TwoWay}"
                TextChanged="Input_TextChanged"
                KeyDown="Input_KeyDown"
                GotFocus="Input_GotFocus"
                LostFocus="Input_LostFocus">
                <TextBox.RenderTransform>
                    <TranslateTransform Y="10" />
                </TextBox.RenderTransform>
            </TextBox>
            <Viewbox Width="14" Height="14" Margin="0,0,13,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                <SymbolIcon Symbol="Find" />
            </Viewbox>
        </Grid>
    </Border>
</UserControl>
