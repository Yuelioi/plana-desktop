<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Plana_ControlCenter.Controls.SearchField"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Height="40">
        <TextBox
            x:Name="Input"
            Height="40"
            Padding="12,8,70,0"
            VerticalContentAlignment="Center"
            PlaceholderText="{x:Bind PlaceholderText, Mode=OneWay}"
            Text="{x:Bind Text, Mode=TwoWay}"
            TextChanged="Input_TextChanged"
            KeyDown="Input_KeyDown" />
        <Viewbox x:Name="SearchGlyph" Width="14" Height="14" Margin="0,0,13,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
            <SymbolIcon Symbol="Find" />
        </Viewbox>
    </Grid>
</UserControl>
