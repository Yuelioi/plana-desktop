<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Plana_ControlCenter.QuickLaunchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Plana_ControlCenter">
    <Window.SystemBackdrop><MicaBackdrop Kind="BaseAlt" /></Window.SystemBackdrop>
    <Border
        x:Name="LauncherSurface"
        Padding="14,14,14,11"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="16"
        KeyDown="LauncherSurface_KeyDown">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <AutoSuggestBox
                x:Name="SearchBox"
                MinHeight="50"
                Padding="14,0"
                QueryIcon="Find"
                PlaceholderText="搜索动作"
                TextChanged="SearchBox_TextChanged"
                SuggestionChosen="SearchBox_SuggestionChosen"
                QuerySubmitted="SearchBox_QuerySubmitted">
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="local:QuickLaunchRow">
                        <Grid MinWidth="594" Padding="6,7" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <SymbolIcon VerticalAlignment="Center" Symbol="{x:Bind Icon}" />
                            <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Subtitle}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind Source}" />
                        </Grid>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                <StackPanel x:Name="GroupBar" Orientation="Horizontal" Spacing="7" />
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
