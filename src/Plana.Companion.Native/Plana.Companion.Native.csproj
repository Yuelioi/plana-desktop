<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <AssemblyName>Plana.Desktop</AssemblyName>
    <ApplicationIcon>..\Plana.Brand\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Plana.Core\Plana.Core.csproj" />
    <ProjectReference Include="..\Plana.TransientUI\Plana.TransientUI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="StarterPacks\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Plana.Companion.Godot.Renderer\character-packs\plana\character.json" Link="CharacterPacks\plana\character.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Plana.Companion.Godot.Renderer\character-packs\plana\NP0035_spr.skel" Link="CharacterPacks\plana\NP0035_spr.skel" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Plana.Companion.Godot.Renderer\character-packs\plana\NP0035_spr.atlas" Link="CharacterPacks\plana\NP0035_spr.atlas" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Plana.Companion.Godot.Renderer\character-packs\plana\NP0035_spr.png" Link="CharacterPacks\plana\NP0035_spr.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Plana.Brand\AppIcon.ico" Link="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Plana.Brand\AppIcon.png" Link="Assets\AppIcon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
