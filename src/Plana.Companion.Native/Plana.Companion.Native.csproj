<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <AssemblyName>Plana.Desktop</AssemblyName>
    <WebView2EnableCsWinRTProjection>true</WebView2EnableCsWinRTProjection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Plana.Core\Plana.Core.csproj" />
    <ProjectReference Include="..\Plana.TransientUI\Plana.TransientUI.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\Plana.Desktop\Renderer\**\*" Link="Renderer\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Plana.Desktop\StarterPacks\**\*" Link="StarterPacks\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Plana.Companion.Godot.Renderer\character-packs\plana\character.json" Link="CharacterPacks\plana\character.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Plana.Desktop\Renderer\spine\plana\NP0035_spr.skel" Link="CharacterPacks\plana\NP0035_spr.skel" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Plana.Desktop\Renderer\spine\plana\NP0035_spr.atlas" Link="CharacterPacks\plana\NP0035_spr.atlas" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Plana.Desktop\Renderer\spine\plana\NP0035_spr.png" Link="CharacterPacks\plana\NP0035_spr.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
