<Window x:Class="Plana.Desktop.ToolGroupManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource ToolGroupsTitle}"
        Width="760" Height="580" MinWidth="680" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{DynamicResource ToolGroupsHeading}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource ToolGroupsHelp}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="10" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox x:Name="GroupList" DisplayMemberPath="Name" SelectionChanged="OnGroupSelectionChanged" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Button Content="{DynamicResource NewGroupButton}" Appearance="Primary" Click="OnNewGroupClick" Margin="0,0,8,0" />
                        <ui:Button Content="{DynamicResource DeleteGroupButton}" Appearance="Danger" Click="OnDeleteGroupClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="18" Margin="16,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource ToolGroupNameLabel}" FontWeight="SemiBold" />
                    <TextBox x:Name="GroupNameTextBox" Grid.Row="1" Margin="0,6,0,16" />
                    <ListBox x:Name="AvailableActionsList" Grid.Row="2" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,5">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <TextBlock x:Name="EditorErrorText" Foreground="#B3261E" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <ui:Button Content="{DynamicResource SaveGroupButton}" Appearance="Primary"
                                   HorizontalAlignment="Right" Click="OnSaveGroupClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <ui:Button Grid.Row="2" Content="{DynamicResource CloseButton}" Appearance="Secondary"
                   HorizontalAlignment="Right" IsCancel="True" />
    </Grid>
</Window>
